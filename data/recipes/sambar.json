  "steps": [
    { "order": 1, "instruction": "Pressure-cook the {toor-dal} with the {turmeric} and 2 cups water for 3-4 whistles until soft. Mash it smooth.", "ingredientRefs": ["toor-dal", "turmeric"], "timerSeconds": 900 },
    { "order": 2, "instruction": "In a separate pot, cook the {mixed-veg} in water until just tender (not mushy).", "ingredientRefs": ["mixed-veg"], "timerSeconds": 600 },
    { "order": 3, "instruction": "Add the {tamarind} pulp, {sambar-powder}, and {salt} to the cooked vegetables. Simmer for 5-6 minutes.", "ingredientRefs": ["tamarind", "sambar-powder", "salt"], "timerSeconds": 360 },
